<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="300" viewBox="0 0 1000 300">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#101321"/>
      <stop offset="50%" stop-color="#111827"/>
      <stop offset="100%" stop-color="#0b1020"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#ec4899"/>
      <stop offset="50%" stop-color="#8b5cf6"/>
      <stop offset="100%" stop-color="#3b82f6"/>
      <animate attributeName="x1" values="0;1;0" dur="7.5s" repeatCount="indefinite"/>
      <animate attributeName="x2" values="1;0;1" dur="7.5s" repeatCount="indefinite"/>
    </linearGradient>
    <radialGradient id="glow">
      <stop offset="0%" stop-color="#ec4899" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#ec4899" stop-opacity="0"/>
    </radialGradient>
    <filter id="blur"><feGaussianBlur stdDeviation="30"/></filter>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#000" flood-opacity="0.4"/></filter>
  </defs>

  <rect x="2" y="2" width="996" height="296" rx="24" fill="url(#bg)" stroke="#30363d" stroke-width="2"/>
  <rect x="2" y="2" width="996" height="296" rx="24" fill="none" stroke="url(#accent)" stroke-width="2" opacity="0.75">
    <animate attributeName="opacity" values="0.45;0.9;0.45" dur="4.5s" repeatCount="indefinite"/>
  </rect>

  <circle cx="800" cy="70" r="155" fill="url(#glow)" filter="url(#blur)">
    <animate attributeName="cx" values="800;730;800" dur="8s" repeatCount="indefinite"/>
  </circle>
  <circle cx="900" cy="225" r="115" fill="#3b82f6" opacity="0.10" filter="url(#blur)">
    <animate attributeName="cy" values="225;180;225" dur="6.5s" repeatCount="indefinite"/>
  </circle>

  <text x="48" y="66" fill="#f8fafc" font-size="32" font-family="Segoe UI, Inter, Arial, sans-serif" font-weight="700">Vaulted</text>
  <rect x="48" y="84" width="116" height="28" rx="14" fill="#8b5cf6" fill-opacity="0.2" stroke="#a78bfa" stroke-opacity="0.7"/>
  <text x="106" y="103" text-anchor="middle" fill="#ddd6fe" font-size="12" font-family="Segoe UI, Inter, Arial, sans-serif" font-weight="700">PRIVATE PROJECT</text>

  <text x="48" y="146" fill="#cbd5e1" font-size="18" font-family="Segoe UI, Inter, Arial, sans-serif">A modern music library and player focused on playlists, profiles,</text>
  <text x="48" y="174" fill="#cbd5e1" font-size="18" font-family="Segoe UI, Inter, Arial, sans-serif">audio tools, customization and a clean native iOS experience.</text>

  <g font-family="Segoe UI, Inter, Arial, sans-serif" font-size="13" font-weight="600">
    <rect x="48" y="218" width="72" height="30" rx="9" fill="#161b22" stroke="#30363d"/>
    <text x="84" y="238" text-anchor="middle" fill="#fb7185">Swift</text>
    <rect x="130" y="218" width="84" height="30" rx="9" fill="#161b22" stroke="#30363d"/>
    <text x="172" y="238" text-anchor="middle" fill="#86efac">Node.js</text>
    <rect x="224" y="218" width="96" height="30" rx="9" fill="#161b22" stroke="#30363d"/>
    <text x="272" y="238" text-anchor="middle" fill="#4ade80">MongoDB</text>
    <rect x="330" y="218" width="86" height="30" rx="9" fill="#161b22" stroke="#30363d"/>
    <text x="373" y="238" text-anchor="middle" fill="#c4b5fd">REST API</text>
  </g>

  <g filter="url(#shadow)">
    <rect x="610" y="52" width="334" height="194" rx="22" fill="#090d18" stroke="#334155"/>
    <rect x="626" y="70" width="70" height="160" rx="16" fill="#121827"/>
    <rect x="710" y="70" width="218" height="36" rx="12" fill="#111827"/>
    <rect x="710" y="120" width="218" height="110" rx="16" fill="#121827" stroke="#24314a"/>
    <circle cx="661" cy="101" r="18" fill="url(#accent)"/>
    <rect x="642" y="136" width="38" height="8" rx="4" fill="#334155"/>
    <rect x="642" y="156" width="28" height="8" rx="4" fill="#1f2937"/>
    <rect x="726" y="86" width="94" height="8" rx="4" fill="#334155"/>
    <circle cx="761" cy="171" r="28" fill="#8b5cf6" fill-opacity="0.20" stroke="#8b5cf6"/>
    <polygon points="753,157 753,185 777,171" fill="#c4b5fd"/>
    <rect x="812" y="150" width="86" height="8" rx="4" fill="url(#accent)"/>
    <rect x="812" y="172" width="66" height="7" rx="3.5" fill="#334155"/>
    <rect x="812" y="192" width="44" height="7" rx="3.5" fill="#1f2937"/>
  </g>

  <rect x="595" y="42" width="360" height="214" rx="24" fill="none" stroke="url(#accent)" stroke-width="2" opacity="0.25">
    <animate attributeName="opacity" values="0.15;0.55;0.15" dur="4.2s" repeatCount="indefinite"/>
  </rect>
</svg>
